# Локальная защита портала. Не оставляйте пустым, если открываете доступ не только с 127.0.0.1.
PORTAL_TOKEN=change-me-to-a-long-random-value

# Уведомление о готовом ежедневном дайджесте в личный Telegram.
# Оставьте пустым, если уведомления пока не нужны.
TELEGRAM_BOT_TOKEN=
TELEGRAM_DIGEST_CHAT_ID=

# CMS сайта. Сейчас поддержан WordPress REST API с Application Password.
CMS_TYPE=wordpress
WORDPRESS_API_BASE=https://example.org/wp-json/wp/v2
WORDPRESS_USER=
WORDPRESS_APP_PASSWORD=
